# Theo quy ước repo: dữ liệu tải về / sinh ra không commit.
# Tạo lại bằng: python scripts/fetch_sources.py && python scripts/fetch_ntrs.py && python -m assistant.ingest
.env
.usage.json
logs/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
eval/results.jsonl
eval/results_offline.jsonl
eval/*.rescored.jsonl

# NGOẠI LỆ: snapshot dữ liệu runtime (~2.2 MB) để cả nhóm pull về chạy được ngay và cho kết quả giống nhau.
# PDF gốc (data/raw/ntrs, ~32 MB) vẫn KHÔNG commit; chỉ cần khi muốn ingest lại.
!data/processed/chunks.jsonl
!data/processed/embeddings.npz
!data/raw/psi_combustion.json
.venv/
