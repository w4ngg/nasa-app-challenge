# Copy thành .env rồi điền key. KHÔNG commit file .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Giá USD / 1 triệu token – kiểm tra lại trên trang giá DeepSeek
DEEPSEEK_PRICE_INPUT_PER_M=0.27
DEEPSEEK_PRICE_OUTPUT_PER_M=1.10
LLM_BUDGET_USD=9.0
# Khi Module 5 có hàm predict(): PREDICT_IMPORT=module5.model:predict
PREDICT_IMPORT=
# Khi Module 4 có hàm rank(): RANK_IMPORT=module4.insights:rank   (hợp đồng: xem assistant/ranking.py)
RANK_IMPORT=
# Trần số lần search_documents mỗi câu hỏi (không tính prefetch)
MAX_SEARCHES=3
# Bộ truy xuất: hybrid (BM25 + embedding, cần `pip install -r requirements-embed.txt`) | bm25 | dense
RETRIEVER=hybrid
EMBED_MODEL=BAAI/bge-base-en-v1.5
# weighted = 0.6·BM25 + 0.4·cosine (chuẩn hóa) | rrf
HYBRID_FUSION=weighted
HYBRID_ALPHA=0.6
# cosine >= DENSE_MIN_SIM: embedding tự đề cử chunk; cosine < DENSE_FLOOR: loại chunk BM25 lạc nghĩa
DENSE_MIN_SIM=0.6
DENSE_FLOOR=0.45
# Khi Module 1 có bảng: INVESTIGATIONS_CSV=../module1/investigations.csv
# auto = tự chạy offline khi không có key | 1 = luôn offline | 0 = bắt buộc dùng LLM
OFFLINE_MODE=auto
# DeepSeek lỗi / hết ngân sách -> tự trả lời offline thay vì báo lỗi
FALLBACK_OFFLINE=1
# Trace & nén context
TRACE_ENABLED=1
HISTORY_KEEP_TURNS=4
HISTORY_SUMMARY=1
EVIDENCE_CHAR_BUDGET=24000
