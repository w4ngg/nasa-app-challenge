# API settings. Relative paths resolve from the repository root.
FLAME_CATALOG_PATH=data/processed/catalog.json
FLAME_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dev server proxy for the optional API. The web app itself reads static JSON from apps/web/public/data.
FLAME_API_PROXY_TARGET=http://127.0.0.1:8000
